# Copy to .env and fill in. Never commit .env.
# Values below are placeholders, not working credentials.

# development or production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# docker compose builds DATABASE_URL from these. Elsewhere, set DATABASE_URL directly,
# e.g. postgresql://USER:PASSWORD@HOST:5432/DBNAME (postgres:// URLs are accepted too).
POSTGRES_USER=datasentry
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_DB=datasentry
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Comma-separated browser origins allowed to call the API. Not needed when the API serves the web app itself.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# Reverse proxies in front of the API that append to X-Forwarded-For (0 = ignore that header).
TRUSTED_PROXY_HOPS=0

# Where uploaded files live: "local" (STORAGE_DIR, needs a persistent disk) or "database" (stored in PostgreSQL).
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=25
MAX_ROWS=500000

# Scheduler: embedded (thread in the API), worker (python -m app.worker), external (cron calls
# POST /api/v1/jobs/run-due with X-Cron-Secret) or off.
SCHEDULER_MODE=embedded
CRON_SECRET=

# Public access
ALLOW_REGISTRATION=true
DEMO_MODE_ENABLED=true
DEMO_WORKSPACE_TTL_HOURS=24
MAX_DEMO_WORKSPACES=200

# Model prediction logging defaults: none | aggregate | full
PREDICTION_FEATURE_LOGGING=aggregate
PREDICTION_RETENTION_DAYS=90

# Optional email notifications (leave blank to keep in-app notifications only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Only read by python -m app.seed when creating a new admin
SEED_ADMIN_PASSWORD=
